{
  "name": "ruiz-store-pos",
  "private": true,
  "version": "5.0.0",
  "description": "Ruiz Store POS — desktop point-of-sale application",
  "author": "Ruiz Store",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "tsc && vite build",
    "build:server": "npm --prefix server run build",
    "preview": "vite preview",
    "electron": "node electron/scripts/launch.cjs .",
    "electron:dev": "concurrently -k -n SERVER,VITE,ELECTRON -c blue,green,magenta \"npm:dev:server\" \"npm:dev\" \"wait-on http-get://localhost:5173 http-get://localhost:3001/api/health && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node electron/scripts/launch.cjs .\"",
    "dist": "npm run build && npm run build:server && electron-builder --win",
    "dist:dir": "npm run build && npm run build:server && electron-builder --dir",
    "dist:mac": "npm run build && npm run build:server && electron-builder --mac",
    "dist:linux": "npm run build && npm run build:server && electron-builder --linux",
    "dist:all": "npm run build && npm run build:server && electron-builder -mwl"
  },
  "build": {
    "appId": "com.ruizstore.pos",
    "productName": "Ruiz Store POS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "server/**/*",
      "build/icon.png",
      "!server/src/**/*",
      "!server/tsconfig.json",
      "!node_modules/**/*",
      "!**/*.map",
      "!server/node_modules/typescript/**",
      "!server/node_modules/@esbuild/**",
      "!server/node_modules/esbuild/**",
      "!server/node_modules/tsx/**",
      "!server/node_modules/@types/**"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/**/*",
      "server/**/*",
      "build/icon.png"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ruiz Store POS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Ruiz Store POS"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    }
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.3",
    "@radix-ui/react-tabs": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsbarcode": "^3.12.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.473.0",
    "motion": "^12.10.5",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.2.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.6",
    "@types/jsbarcode": "^3.11.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.2",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.6",
    "typescript": "~5.6.3",
    "vite": "^6.3.5",
    "wait-on": "^9.1.0"
  }
}
